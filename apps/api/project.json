{
  "name": "api",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/api/musikquiz_api",
  "projectType": "application",
  "tags": [],
  "targets": {
    "setup": {
      "executor": "nx:run-commands",
      "options": {
        "cwd": "apps/api",
        "commands": [
          "python -m venv .venv",
          ".venv\\Scripts\\python.exe -m pip install --upgrade pip",
          ".venv\\Scripts\\python.exe -m pip install -r requirements.txt"
        ],
        "parallel": false
      }
    },
    "serve": {
      "executor": "nx:run-commands",
      "continuous": true,
      "options": {
        "cwd": "apps/api",
        "command": ".venv\\Scripts\\python.exe -m uvicorn musikquiz_api.main:app --host 127.0.0.1 --port 8000"
      }
    }
  }
}
